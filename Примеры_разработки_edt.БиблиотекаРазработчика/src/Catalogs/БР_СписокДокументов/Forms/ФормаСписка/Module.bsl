

#Область ОбработчикиСобытийФормы

// Обрабатывает оповещения формы и обновляет список при изменении состава справочника.
//
// Параметры:
//   ИмяСобытия - Строка - имя события;
//   Параметр - Произвольный - параметр события; не используется.
//   Источник - Произвольный - источник события; не используется.
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ОбновитьСписокБиблиотеки" Тогда
		Элементы.Список.Обновить();
		ОбновитьОтображениеДанных();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

// Обрабатывает выбор строки списка: открывает форму редактора кода для выбранного
// элемента справочника. Выбор группы игнорируется.
//
// Параметры:
//   Элемент - ТаблицаФормы - таблица списка, в которой произошел выбор; не используется.
//   ВыбраннаяСтрока - СправочникСсылка.БР_СписокДокументов, Неопределено - выбранный элемент.
//   Поле - ПолеФормы - поле, в котором произошел выбор; не используется.
//   СтандартнаяОбработка - Булево - отключается, так как форма открывается вручную.
&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка=Ложь;
	ПараметрыОткрытия = Новый Структура;
	
	Если СписокВыборНаСервере(ВыбраннаяСтрока,ПараметрыОткрытия) Тогда
		ОткрытьФорму("Обработка.РедакторКодаBslПример.Форма.Форма",ПараметрыОткрытия);
	КонецЕсли;
КонецПроцедуры

// Открывает форму редактора кода при добавлении строки списка.
// Добавление элементов в список запрещено, разрешено только добавление групп.
//
// Параметры:
//   Элемент - ТаблицаФормы - таблица списка; не используется.
//   Отказ - Булево - устанавливается в Истина, если добавление строки отменяется.
//   Копирование - Булево - признак копирования строки; не используется.
//   Родитель - СправочникСсылка.БР_СписокДокументов - родитель добавляемой строки; не используется.
//   Группа - Булево - Истина, если добавляется группа.
//   Параметр - Произвольный - дополнительные параметры добавления; не используются.
&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если не Группа Тогда
		Отказ=Истина;
		ВыбраннаяСтрока=Неопределено;
		ПараметрыОткрытия = Новый Структура;
		Если СписокВыборНаСервере(ВыбраннаяСтрока,ПараметрыОткрытия) Тогда
			ОткрытьФорму("Обработка.РедакторКодаBslПример.Форма.Форма",ПараметрыОткрытия);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыФайлы

// Обрабатывает активизацию строки таблицы файлов.
// Оставлен как точка расширения обработчика события формы.
//
// Параметры:
//   Элемент - ТаблицаФормы - таблица файлов; не используется.
&НаКлиенте
Процедура ТаблицаФайловПриАктивизацииСтроки(Элемент)
КонецПроцедуры

// Открывает форму присоединенного файла, выбранного в таблице файлов.
//
// Параметры:
//   Элемент - ТаблицаФормы - таблица файлов; не используется.
//   ВыбраннаяСтрока - Строка - идентификатор выбранной строки; не используется.
//   Поле - ПолеФормы - поле, в котором произошел выбор; не используется.
//   СтандартнаяОбработка - Булево - отключается, так как форма открывается вручную.
&НаКлиенте
Процедура ФайлыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ДанныеСтроки = Элементы.Файлы.ТекущиеДанные;
	Если ДанныеСтроки <> Неопределено Тогда
		ПараметрыФормы = Новый Структура("Ключ", ДанныеСтроки.Файл);
		ОткрытьФорму("Справочник.Файлы.ФормаОбъекта", ПараметрыФормы);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Открывает диалог выбора файла и добавляет выбранный файл к текущему элементу справочника.
// Для групп добавление файлов не выполняется.
//
// Параметры:
//   Команда - КомандаФормы - команда, инициировавшая вызов; не используется.
&НаКлиенте
Процедура ДобавитьФайлВДокумент(Команда)
	ДанныеНаСервере=Новый Структура("ЭтоГруппа,СсылкаНаФайл,СсылкаВладелецФайла",Неопределено);
	ДобавитьФайлВДокументНаСервере(ДанныеНаСервере);
	Если ДанныеНаСервере.ЭтоГруппа=Ложь Тогда
		Режим = РежимДиалогаВыбораФайла.Открытие;
		ДиалогОткрытия = Новый ДиалогВыбораФайла(Режим);
		ДиалогОткрытия.ПолноеИмяФайла = "";
		Фильтр = "Выберите файл  (*.*)|*.*";
		ДиалогОткрытия.Фильтр = Фильтр;
		ДиалогОткрытия.МножественныйВыбор = Ложь;
		ДиалогОткрытия.Заголовок = "Выберете файл для загрузки";
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗагрузкиФайла",ЭтотОбъект);
		
		ДиалогОткрытия.Показать(ОписаниеОповещения);
		
	КонецЕсли;
КонецПроцедуры

// Запрашивает подтверждение и удаляет присоединенный файл текущего элемента справочника.
//
// Параметры:
//   Команда - КомандаФормы - команда, инициировавшая вызов; не используется.
&НаКлиенте
Процедура УдалитьФайлИзДокумента(Команда)
	ОписаниеОповещения = Новый ОписаниеОповещения("УдалитьПрисоединенныйФайл", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, НСтр("ru = 'Удалить присоединенный файл?'"), РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

// Открывает форму удаления объектов, помеченных на удаление.
//
// Параметры:
//   Команда - КомандаФормы - команда, инициировавшая вызов; не используется.
&НаКлиенте
Процедура УдалитьДокументыПомеченныеНаУдаление(Команда)
	ПараметрыОткрытия = Новый Структура;
	ОткрытьФорму("Обработка.УдалениеПомеченныхОбъектов.Форма.ОсновнаяФорма",ПараметрыОткрытия);
КонецПроцедуры

// Выгружает элементы и группы справочника на диск в каталог, выбранный пользователем.
//
// Параметры:
//   Команда - КомандаФормы - команда, инициировавшая вызов; не используется.
&НаКлиенте
Процедура ВыгрузитьНаДиск(Команда)
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбора.Заголовок = НСтр("ru = 'Каталог выгрузки элементов справочника'");
	ДиалогВыбора.МножественныйВыбор = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьНаДискЗавершение", ЭтотОбъект);
	ДиалогВыбора.Показать(ОписаниеОповещения);
КонецПроцедуры

// Загружает в справочник каталог, выбранный пользователем: каталог и его подкаталоги
// становятся группами, html-файлы - подчиненными им элементами.
//
// Параметры:
//   Команда - КомандаФормы - команда, инициировавшая вызов; не используется.
&НаКлиенте
Процедура ЗагрузитьИзКаталога(Команда)
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбора.Заголовок = НСтр("ru = 'Каталог загрузки html-файлов'");
	ДиалогВыбора.МножественныйВыбор = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузитьИзКаталогаЗавершение", ЭтотОбъект);
	ДиалогВыбора.Показать(ОписаниеОповещения);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет параметры открытия формы редактора кода для выбранной строки списка.
//
// Параметры:
//   ВыбраннаяСтрока - СправочникСсылка.БР_СписокДокументов, Неопределено - выбранный элемент;
//                     для Неопределено используется пустая ссылка.
//   ПараметрыОткрытия - Структура - параметры открытия формы, заполняются в процессе работы:
//     * Ключ - СправочникСсылка.БР_СписокДокументов - открываемый элемент;
//     * Текст - Строка - текст документа;
//     * ТекстJson - Строка - JSON-представление токенов документа;
//     * Наименование - Строка - наименование элемента;
//     * Родитель - СправочникСсылка.БР_СписокДокументов - родительская группа элемента.
//
// Возвращаемое значение:
//   Булево - Истина, если форму нужно открыть; Ложь, если выбрана группа.
&НаСервере
Функция СписокВыборНаСервере(ВыбраннаяСтрока,ПараметрыОткрытия)
	СсылкаНаЭлементСправочникаПустая=ПолучитьПустуюСсылку();
	Если ВыбраннаяСтрока=Неопределено Тогда
		ВыбраннаяСтрока=СсылкаНаЭлементСправочникаПустая;
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыбраннаяСтрока, "ЭтоГруппа,Файлы,Родитель");
	
	Если ЗначениеЗаполнено(ЗначенияРеквизитов.ЭтоГруппа) И ЗначенияРеквизитов.ЭтоГруппа Тогда
		Возврат Ложь;
	Иначе
		ПараметрыОткрытия.Вставить("Ключ", ВыбраннаяСтрока);
		ПараметрыОткрытия.Вставить("Текст", ВыбраннаяСтрока.Текст);
		ПараметрыОткрытия.Вставить("ТекстJson", ВыбраннаяСтрока.ТекстJson);
		ПараметрыОткрытия.Вставить("Наименование", ВыбраннаяСтрока.Наименование);
		Если ВыбраннаяСтрока=СсылкаНаЭлементСправочникаПустая Тогда
			Родитель=Элементы.Список.ТекущаяСтрока.Родитель;
		Иначе
			Родитель=ЗначенияРеквизитов.Родитель;
		КонецЕсли;
		ПараметрыОткрытия.Вставить("Родитель", Родитель);
		Возврат Истина;
	КонецЕсли;
КонецФункции

// Обрабатывает завершение диалога выбора файла и добавляет файл к текущему элементу.
//
// Параметры:
//   ВыбранныеФайлы - Массив из Строка, Неопределено - пути выбранных файлов;
//                    обрабатывается только первый элемент.
//   ПараметрыЧтения - Произвольный - параметры чтения файлов; не используются.
&НаКлиенте
Процедура ПослеЗагрузкиФайла(ВыбранныеФайлы, ПараметрыЧтения) Экспорт

	Если не ЗначениеЗаполнено(ВыбранныеФайлы) Тогда
		Возврат;
	ИначеЕсли ЗначениеЗаполнено(ВыбранныеФайлы) И ВыбранныеФайлы.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранныйФайл=ВыбранныеФайлы[0];
	ПослеЗагрузкиФайлаНаСервере(ВыбранныйФайл);
	Оповестить("ОбновитьСписокБиблиотеки", , ЭтотОбъект);
КонецПроцедуры

// Обрабатывает ответ пользователя на вопрос об удалении присоединенного файла.
//
// Параметры:
//   РезультатВопроса - КодВозвратаДиалога - выбранный пользователем вариант ответа.
//   ДополнительныеПараметры - Произвольный - дополнительные параметры обработчика оповещения;
//                             не используются.
&НаКлиенте
Процедура УдалитьПрисоединенныйФайл(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	ДанныеСтроки = Элементы.Файлы.ТекущиеДанные;
	Если ДанныеСтроки <> Неопределено Тогда
		ФайлСсылка=ДанныеСтроки.Файл;
		УдалитьФайлИзДокументаНаСервере(ФайлСсылка);
		Оповестить("ОбновитьСписокБиблиотеки", , ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

// Обрабатывает завершение выбора каталога и запускает выгрузку на сервере.
//
// Параметры:
//   ВыбранныеФайлы - Массив из Строка, Неопределено - результат диалога выбора каталога;
//                    обрабатывается только первый элемент.
//   Параметры - Произвольный - дополнительные параметры обработчика оповещения; не используются.
&НаКлиенте
Процедура ВыгрузитьНаДискЗавершение(ВыбранныеФайлы, Параметры) Экспорт
	Если Не ЗначениеЗаполнено(ВыбранныеФайлы) Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	РезультатВыгрузки = ВыгрузитьНаДискНаСервере(ВыбранныеФайлы[0]);
	
	ТекстСообщения = СтрШаблон(
		НСтр("ru = 'Выгрузка завершена. Создано каталогов: %1, записано html-страниц: %2.'"),
		РезультатВыгрузки.ВыгруженоГрупп,
		РезультатВыгрузки.ВыгруженоЭлементов);
	Сообщить(ТекстСообщения);
КонецПроцедуры

// Обрабатывает завершение выбора каталога и запускает загрузку на сервере.
//
// Параметры:
//   ВыбранныеФайлы - Массив из Строка, Неопределено - результат диалога выбора каталога;
//                    обрабатывается только первый элемент.
//   Параметры - Произвольный - дополнительные параметры обработчика оповещения; не используются.
&НаКлиенте
Процедура ЗагрузитьИзКаталогаЗавершение(ВыбранныеФайлы, Параметры) Экспорт
	Если Не ЗначениеЗаполнено(ВыбранныеФайлы) Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	РезультатЗагрузки = ЗагрузитьИзКаталогаНаСервере(ВыбранныеФайлы[0]);
	
	ТекстСообщения = СтрШаблон(
		НСтр("ru = 'Загрузка завершена. Загружено групп: %1, элементов: %2.'"),
		РезультатЗагрузки.ЗагруженоГрупп,
		РезультатЗагрузки.ЗагруженоЭлементов);
	Сообщить(ТекстСообщения);
	
	Оповестить("ОбновитьСписокБиблиотеки", , ЭтотОбъект);
КонецПроцедуры

// Заполняет данные для добавления файла: признак группы и владельца файла.
//
// Параметры:
//   ДанныеНаСервере - Структура - данные добавления файла, заполняются в процессе работы:
//     * ЭтоГруппа - Булево - Истина, если текущая строка списка является группой;
//     * СсылкаНаФайл - СправочникСсылка.Файлы - ссылка на файл;
//     * СсылкаВладелецФайла - СправочникСсылка.БР_СписокДокументов - владелец файла.
&НаСервере
Процедура ДобавитьФайлВДокументНаСервере(ДанныеНаСервере)     
	ТекущаяСтрокаСписка = Элементы.Список.ТекущаяСтрока;
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущаяСтрокаСписка, "ЭтоГруппа");
	
	Если ЗначенияРеквизитов.ЭтоГруппа<>Неопределено И ЗначенияРеквизитов.ЭтоГруппа Тогда
		ДанныеНаСервере.ЭтоГруппа=Истина;
	ИначеЕсли ЗначенияРеквизитов.ЭтоГруппа<>Неопределено И не ЗначенияРеквизитов.ЭтоГруппа Тогда
		ДанныеНаСервере.ЭтоГруппа=Ложь;                  
	КонецЕсли;                            	
	ДанныеНаСервере.СсылкаНаФайл=Справочники.Файлы.ПустаяСсылка();
	ДанныеНаСервере.СсылкаВладелецФайла=ТекущаяСтрокаСписка;
КонецПроцедуры


// Добавляет выбранный с диска файл к текущему элементу справочника и записывает элемент.
//
// Параметры:
//   ВыбранныйФайл - Строка - полный путь к выбранному файлу.
&НаСервере
Процедура ПослеЗагрузкиФайлаНаСервере(ВыбранныйФайл)
	СправочникСсылка=Элементы.Список.ТекущаяСтрока;
	СправочникОбъект=СправочникСсылка.ПолучитьОбъект();
	ФайлСсылка = РаботаСФайлами.ДобавитьФайлСДиска(СправочникСсылка, ВыбранныйФайл);
	СтрокаТч=СправочникОбъект.Файлы.Добавить();
	СтрокаТч.Файл=ФайлСсылка;
	СправочникОбъект.Записать();
	//Сообщить("Создан файл: " + Строка(ФайлСсылка));

КонецПроцедуры	

// Возвращает ссылку на присоединенный файл владельца с указанными именем и расширением.
//
// Параметры:
//   СсылкаНаВладельца - СправочникСсылка.БР_СписокДокументов - объект-владелец файла.
//   ИмяФайлаБезРасширения - Строка - искомое наименование файла без расширения.
//   Расширение - Строка - расширение файла без точки.
//
// Возвращаемое значение:
//   СправочникСсылка.Файлы, Неопределено - найденный файл или Неопределено, если файл не найден.
&НаСервере
Функция НайтиСуществующийФайл(СсылкаНаВладельца, ИмяФайлаБезРасширения, Расширение)
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |	Файлы.Ссылка КАК Ссылка
        |ИЗ
        |	Справочник.Файлы КАК Файлы
        |ГДЕ
        |	Файлы.ВладелецФайла = &ВладелецФайла
        |	И Файлы.Наименование = &ИмяБезРасширения
        |	И Файлы.Расширение = &Расширение
        |	И НЕ Файлы.ПометкаУдаления";
    
    Запрос.УстановитьПараметр("ВладелецФайла", СсылкаНаВладельца);
    Запрос.УстановитьПараметр("ИмяБезРасширения", ИмяФайлаБезРасширения);
    Запрос.УстановитьПараметр("Расширение", Расширение);
    
    Результат = Запрос.Выполнить();
    Если Результат.Пустой() Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Выборка = Результат.Выбрать();
    Выборка.Следующий();
    Возврат Выборка.Ссылка;
    
КонецФункции

// Проверяет, что файл с указанной ссылкой существует в справочнике файлов.
//
// Параметры:
//   ФайлСсылка - СправочникСсылка.Файлы - проверяемая ссылка на файл.
//
// Возвращаемое значение:
//   Булево - Истина, если файл существует; Ложь - если не найден.
&НаСервере
Функция НайтиФайлПоссылке(ФайлСсылка)
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |	Файлы.Ссылка КАК Ссылка
        |ИЗ
        |	Справочник.Файлы КАК Файлы
        |ГДЕ
        |	Файлы.Ссылка = &Ссылка";
    
    Запрос.УстановитьПараметр("Ссылка", ФайлСсылка);
    
    Результат = Запрос.Выполнить();
    Если Результат.Пустой() Тогда
        Возврат Ложь;
	Иначе	         
		Возврат Истина;
    КонецЕсли;
        
КонецФункции

// Удаляет файл и его строку из табличной части файлов текущего элемента справочника.
//
// Параметры:
//   ФайлСсылка - СправочникСсылка.Файлы - ссылка на удаляемый файл.
&НаСервере
Процедура УдалитьФайлИзДокументаНаСервере(ФайлСсылка)    
	Если НайтиФайлПоссылке(ФайлСсылка) Тогда             
		//Сообщить("Удален  файл: " + Строка(ФайлСсылка)); 
		ФайлОбъект=ФайлСсылка.ПолучитьОбъект();
		ФайлОбъект.Удалить();
		//ФайлОбъект.Записать();
	КонецЕсли;	
	
	СправочникСсылка=Элементы.Список.ТекущаяСтрока;
	СправочникОбъект=СправочникСсылка.ПолучитьОбъект();
	ТЧФайлы=СправочникОбъект.Файлы;  
	ТЧФайлы.Удалить(Элементы.Файлы.ТекущаяСтрока);	
	СправочникОбъект.Записать();
	Возврат;
КонецПроцедуры	

// Возвращает пустую ссылку на справочник БР_СписокДокументов.
//
// Возвращаемое значение:
//   СправочникСсылка.БР_СписокДокументов - пустая ссылка.
&НаСервере
Функция ПолучитьПустуюСсылку()
	Возврат Справочники.БР_СписокДокументов.ПустаяСсылка();
КонецФункции	


#Область ВыгрузкаНаДиск

// Выгружает группы и элементы справочника в указанный каталог.
// Группы выгружаются как подкаталоги, элементы - как html-страницы
// в каталоге родительской группы.
//
// Параметры:
//   КаталогВыгрузки - Строка - полный путь каталога, в который выполняется выгрузка.
//
// Возвращаемое значение:
//   Структура:
//     * ВыгруженоГрупп - Число - количество созданных подкаталогов;
//     * ВыгруженоЭлементов - Число - количество записанных html-страниц.
&НаСервере
Функция ВыгрузитьНаДискНаСервере(Знач КаталогВыгрузки)
	Результат = Новый Структура("ВыгруженоГрупп,ВыгруженоЭлементов", 0, 0);
	ДеревоСправочника = ПолучитьДеревоСправочникаНаСервере();
	
	ВыгрузитьУзелДереваНаСервере(ДеревоСправочника, Справочники.БР_СписокДокументов.ПустаяСсылка(),
		КаталогВыгрузки, Результат);
	ЗаписатьИндекснуюСтраницу(ДеревоСправочника, КаталогВыгрузки);
	
	Возврат Результат;
КонецФункции

// Записывает в каталог выгрузки индексную страницу index.html со списком групп
// справочника и ссылками на выгруженные страницы элементов.
//
// Параметры:
//   Дерево - Соответствие из КлючИЗначение - иерархия справочника (см. ПолучитьДеревоСправочникаНаСервере);
//   КаталогВыгрузки - Строка - полный путь каталога выгрузки.
&НаСервере
Процедура ЗаписатьИндекснуюСтраницу(Знач Дерево, Знач КаталогВыгрузки)
	СодержимоеСписка = СформироватьСписокСсылок(Дерево, Справочники.БР_СписокДокументов.ПустаяСсылка(), "");
	
	ТекстHTML = "<html>
	|<head>
	|<meta charset=""windows-1251"">
	|<title>" + ЭкранироватьТекст(Метаданные.Справочники.БР_СписокДокументов.Представление()) + "</title>
	|</head>
	|<body>
	|<ul>
	|" + СодержимоеСписка + "
	|</ul>
	|</body>
	|</html>";
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстHTML);
	ТекстовыйДокумент.Записать(ПолучитьПутьФайла(КаталогВыгрузки, "index.html"), "windows-1251");
КонецПроцедуры

// Возвращает фрагмент html-списка с группами справочника и ссылками на страницы элементов.
//
// Параметры:
//   Дерево - Соответствие из КлючИЗначение - иерархия справочника (см. ПолучитьДеревоСправочникаНаСервере);
//   Родитель - СправочникСсылка.БР_СписокДокументов - узел, содержимое которого формируется;
//   ОтносительныйПуть - Строка - путь каталога узла относительно каталога выгрузки.
//
// Возвращаемое значение:
//   Строка - фрагмент html-списка.
&НаСервере
Функция СформироватьСписокСсылок(Знач Дерево, Знач Родитель, Знач ОтносительныйПуть)
	СтрокиУзла = Дерево[Родитель];
	Если СтрокиУзла = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	РазделительПути = ?(ОтносительныйПуть = "", "", "/");
	Фрагмент = "";
	
	Для Каждого СтрокаДерева Из СтрокиУзла Цикл
		ИмяБезопасное = БезопасноеИмяФайла(СтрокаДерева.Наименование);
		
		Если СтрокаДерева.ЭтоГруппа Тогда
			ПутьГруппы = ОтносительныйПуть + РазделительПути + ИмяБезопасное;
			Фрагмент = Фрагмент + "<li><b>" + ЭкранироватьТекст(СтрокаДерева.Наименование) + "</b>"
				+ "<ul>" + СформироватьСписокСсылок(Дерево, СтрокаДерева.Ссылка, ПутьГруппы) + "</ul></li>";
		Иначе
			Фрагмент = Фрагмент + "<li><a href=""" + ОтносительныйПуть + РазделительПути + ИмяБезопасное + ".html"">"
				+ ЭкранироватьТекст(СтрокаДерева.Наименование) + "</a></li>";
		КонецЕсли;
	КонецЦикла;
	
	Возврат Фрагмент;
КонецФункции

// Возвращает иерархию справочника в виде соответствия "родитель - подчиненные строки".
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение:
//     * Ключ - СправочникСсылка.БР_СписокДокументов - родитель; для строк верхнего уровня - пустая ссылка;
//     * Значение - Массив из Структура:
//         ** Ссылка - СправочникСсылка.БР_СписокДокументов - ссылка на элемент или группу;
//         ** Наименование - Строка - наименование элемента или группы;
//         ** ЭтоГруппа - Булево - Истина для группы;
//         ** ТекстHtml - Строка - html-представление документа;
//         ** Текст - Строка - текст документа.
&НаСервере
Функция ПолучитьДеревоСправочникаНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СписокДокументов.Ссылка КАК Ссылка,
		|	СписокДокументов.Наименование КАК Наименование,
		|	СписокДокументов.ЭтоГруппа КАК ЭтоГруппа,
		|	СписокДокументов.Родитель КАК Родитель,
		|	СписокДокументов.ТекстHtml КАК ТекстHtml,
		|	СписокДокументов.Текст КАК Текст
		|ИЗ
		|	Справочник.БР_СписокДокументов КАК СписокДокументов
		|ГДЕ
		|	НЕ СписокДокументов.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
	
	Дерево = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаДерева = Новый Структура("Ссылка,Наименование", Выборка.Ссылка, Выборка.Наименование);
		СтрокаДерева.Вставить("ЭтоГруппа", Выборка.ЭтоГруппа);
		СтрокаДерева.Вставить("ТекстHtml", Выборка.ТекстHtml);
		СтрокаДерева.Вставить("Текст", Выборка.Текст);
		
		Если Дерево[Выборка.Родитель] = Неопределено Тогда
			Дерево.Вставить(Выборка.Родитель, Новый Массив);
		КонецЕсли;
		Дерево[Выборка.Родитель].Добавить(СтрокаДерева);
	КонецЦикла;
	
	Возврат Дерево;
КонецФункции

// Выгружает подчиненные строки узла иерархии: группы - в подкаталоги, элементы - в html-страницы.
//
// Параметры:
//   Дерево - Соответствие из КлючИЗначение - иерархия справочника (см. ПолучитьДеревоСправочникаНаСервере);
//   Родитель - СправочникСсылка.БР_СписокДокументов - узел, подчиненные строки которого выгружаются;
//   Каталог - Строка - полный путь каталога, соответствующий узлу;
//   Результат - Структура - счетчики выгрузки, заполняются в процессе работы:
//     * ВыгруженоГрупп - Число - количество созданных подкаталогов;
//     * ВыгруженоЭлементов - Число - количество записанных html-страниц.
&НаСервере
Процедура ВыгрузитьУзелДереваНаСервере(Дерево, Родитель, Каталог, Результат)
	СтрокиУзла = Дерево[Родитель];
	Если СтрокиУзла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаДерева Из СтрокиУзла Цикл
		ИмяБезопасное = БезопасноеИмяФайла(СтрокаДерева.Наименование);
		
		Если СтрокаДерева.ЭтоГруппа Тогда
			КаталогГруппы = ПолучитьПутьФайла(Каталог, ИмяБезопасное);
			СоздатьКаталог(КаталогГруппы);
			Результат.ВыгруженоГрупп = Результат.ВыгруженоГрупп + 1;
			ВыгрузитьУзелДереваНаСервере(Дерево, СтрокаДерева.Ссылка, КаталогГруппы, Результат);
		Иначе
			ЗаписатьСтраницу(СтрокаДерева, ПолучитьПутьФайла(Каталог, ИмяБезопасное + ".html"));
			Результат.ВыгруженоЭлементов = Результат.ВыгруженоЭлементов + 1;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Записывает html-страницу элемента справочника в файл.
//
// Параметры:
//   СтрокаДерева - Структура - выгружаемая строка иерархии (см. ПолучитьДеревоСправочникаНаСервере);
//   ПолноеИмяФайла - Строка - полный путь к создаваемому файлу.
&НаСервере
Процедура ЗаписатьСтраницу(СтрокаДерева, ПолноеИмяФайла)
	ТекстСтраницы = СтрокаДерева.ТекстHtml;
	Если ЗначениеЗаполнено(ТекстСтраницы) Тогда
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.УстановитьТекст(ТекстСтраницы);
		ТекстовыйДокумент.Записать(ПолноеИмяФайла, "windows-1251");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ЗагрузкаИзКаталога

// Загружает содержимое каталога в справочник: сам каталог и каждый его подкаталог
// становятся группами, html-файлы каталога - элементами соответствующей группы.
//
// Параметры:
//   КаталогЗагрузки - Строка - полный путь каталога, содержимое которого загружается.
//
// Возвращаемое значение:
//   Структура:
//     * ЗагруженоГрупп - Число - количество созданных или обновленных групп;
//     * ЗагруженоЭлементов - Число - количество созданных или обновленных элементов.
&НаСервере
Функция ЗагрузитьИзКаталогаНаСервере(КаталогЗагрузки,Родитель=Неопределено)
	Результат = Новый Структура("ЗагруженоГрупп,ЗагруженоЭлементов", 0, 0);
	//выбранный в диалоге каталог не учитываем
	//ЗагрузитьКаталогВГруппуНаСервере(КаталогЗагрузки, Результат);
	
	Для Каждого ЭлементКаталога Из НайтиФайлы(КаталогЗагрузки, "*", Ложь) Цикл
		Если Не ЭлементКаталога.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		ЗагрузитьКаталогВГруппуНаСервере(ЭлементКаталога.ПолноеИмя,Родитель, Результат);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Загружает каталог как группу справочника, а его html-файлы - как элементы этой группы.
//
// Параметры:
//   Каталог - Строка - полный путь каталога;
//   Результат - Структура - счетчики загрузки, заполняются в процессе работы:
//     * ЗагруженоГрупп - Число - количество созданных или обновленных групп;
//     * ЗагруженоЭлементов - Число - количество созданных или обновленных элементов.
&НаСервере
Процедура ЗагрузитьКаталогВГруппуНаСервере(Каталог,Родитель, Результат)
	Группа = СоздатьГруппуИзКаталогаНаСервере(Каталог,Родитель);
	Результат.ЗагруженоГрупп = Результат.ЗагруженоГрупп + 1;
	Сообщить(Группа);
	Для Каждого ЭлементКаталога Из НайтиФайлы(Каталог, "*", Ложь) Цикл
//		Если ЭлементКаталога.ЭтоКаталог() Или Не ЭтоФайлHTML(ЭлементКаталога) Тогда
//			Продолжить;
//		КонецЕсли;
		Если ЭлементКаталога.ЭтоКаталог() Тогда
			//рекурсия обработка каталога
			ЗагрузитьКаталогВГруппуНаСервере(ЭлементКаталога.ПолноеИмя,Группа,Результат);
		ИначеЕсли ЭтоФайлHTML(ЭлементКаталога) Тогда
			ЗагрузитьЭлементИзФайлаНаСервере(ЭлементКаталога.ПолноеИмя, Группа);
			Результат.ЗагруженоЭлементов = Результат.ЗагруженоЭлементов + 1;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Возвращает группу справочника с наименованием каталога, создавая ее при отсутствии.
//
// Параметры:
//   Каталог - Строка - полный путь каталога.
//
// Возвращаемое значение:
//   СправочникСсылка.БР_СписокДокументов - группа, соответствующая каталогу.
&НаСервере
Функция СоздатьГруппуИзКаталогаНаСервере(Каталог,Родитель)
	Если ТипЗнч(Каталог)=Тип("Строка") Тогда
		ФайлКаталога = Новый Файл(Каталог);
		Наименование = ФайлКаталога.Имя;
	Иначе
		Наименование = Каталог.Имя;
	КонецЕсли;
	
	Если Родитель=Неопределено Тогда
		Родитель = Справочники.БР_СписокДокументов.ПустаяСсылка();
	КонецЕсли;
	Ссылка = Справочники.БР_СписокДокументов.НайтиПоНаименованию(Наименование, Истина, Родитель);
	Если ЗначениеЗаполнено(Ссылка) И Ссылка.ЭтоГруппа Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Группа = Справочники.БР_СписокДокументов.СоздатьГруппу();
	Группа.Наименование = Наименование;
	Группа.Родитель = Родитель;
	Группа.Записать();
	
	Возврат Группа.Ссылка;
КонецФункции

// Записывает html-файл в элемент справочника: наименование берется из имени файла,
// текст - из элементов span файла.
//
// Параметры:
//   ПолноеИмяФайла - Строка - полный путь к html-файлу;
//   Родитель - СправочникСсылка.БР_СписокДокументов - группа, в которую загружается элемент.
&НаСервере
Процедура ЗагрузитьЭлементИзФайлаНаСервере(ПолноеИмяФайла, Родитель)
	ФайлHTML = Новый Файл(ПолноеИмяФайла);
	Наименование = ФайлHTML.ИмяБезРасширения;
	Текст = ПрочитатьHTMLИзФайлаНаСервере(ПолноеИмяФайла, "windows-1251");
	
	Ссылка = Справочники.БР_СписокДокументов.НайтиПоНаименованию(Наименование, Истина, Родитель);
	Если ЗначениеЗаполнено(Ссылка) И Не Ссылка.ЭтоГруппа Тогда
		ЭлементСправочника = Ссылка.ПолучитьОбъект();
	Иначе
		ЭлементСправочника = Справочники.БР_СписокДокументов.СоздатьЭлемент();
		ЭлементСправочника.Наименование = Наименование;
		ЭлементСправочника.Родитель = Родитель;
		ЭлементСправочника.Текст = Текст;	
	КонецЕсли;
	
	ЭлементСправочника.Записать();
КонецПроцедуры

// Возвращает текст html-файла, собранный из элементов span с учетом их цвета.
//
// Параметры:
//   ВыбранныйФайл - Строка - полный путь к html-файлу;
//   Кодировка - Строка, КодировкаТекста, Неопределено - кодировка файла; если не указана,
//               используется ANSI.
//
// Возвращаемое значение:
//   Строка - текст документа.
&НаСервере
Функция ПрочитатьHTMLИзФайлаНаСервере(ВыбранныйФайл, Кодировка = Неопределено)
	ТекстовоеСодержимое="";
	Токены = Новый Массив;
	ЧтениеHTML = Новый ЧтениеHTML;
	ПостроительDOM = Новый ПостроительDOM;
	
	Если ЗначениеЗаполнено(Кодировка) Тогда
		ЧтениеHTML.ОткрытьФайл(ВыбранныйФайл, Кодировка);
	Иначе
		ЧтениеHTML.ОткрытьФайл(ВыбранныйФайл);
	КонецЕсли;
	
	ДокументHTML = ПостроительDOM.Прочитать(ЧтениеHTML);
	СписокЭлементовDom = ДокументHTML.ПолучитьЭлементыПоИмени("span");
	Для Каждого ТекущийЭлементDom Из СписокЭлементовDom Цикл
		Атрибут = ТекущийЭлементDom.Атрибуты.ПолучитьИменованныйЭлемент("style");
		Цвет = Неопределено;
		Если Атрибут <> Неопределено Тогда
			Части = СтрРазделить(Атрибут.Значение, ";");
			Для Каждого Часть Из Части Цикл
				Пара = СтрРазделить(СокрЛп(Часть), ":");
				Если Пара.Количество() = 2 И СокрЛп(Пара[0]) = "color" Тогда
					Цвет = СокрЛп(Пара[1]);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Текст = ТекущийЭлементDom.ТекстовоеСодержимое;
		Если Цвет = Неопределено Тогда
			Токены.Добавить(Новый Структура("Токен,Цвет", Символы.ПС, Неопределено));
			ТекстовоеСодержимое=ТекстовоеСодержимое+Символы.ПС;
		Иначе
			Токены.Добавить(Новый Структура("Токен,Цвет", Текст, Цвет));
			ТекстовоеСодержимое=ТекстовоеСодержимое+Текст;
		КонецЕсли;
	КонецЦикла;
	
	ЧтениеHTML.Закрыть();
	
	Возврат ТекстовоеСодержимое;
КонецФункции

// Проверяет, что файл каталога имеет расширение html.
//
// Параметры:
//   ФайлКаталога - Файл - проверяемый файл.
//
// Возвращаемое значение:
//   Булево - Истина, если файл имеет расширение html или htm.
&НаСервере
Функция ЭтоФайлHTML(Знач ФайлКаталога)
	Расширение = ВРег(ФайлКаталога.Расширение);
	
	Возврат Расширение = ".HTML" Или Расширение = ".HTM";
КонецФункции

#КонецОбласти

// Экранирует спецсимволы HTML, чтобы текст не ломал разметку.
//
// Параметры:
//   Текст - Строка - исходный текст.
//
// Возвращаемое значение:
//   Строка - текст, безопасный для вставки в html-разметку.
&НаСервере
Функция ЭкранироватьТекст(Знач Текст)
	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	
	Возврат Результат;
КонецФункции

// Возвращает полный путь файла или каталога в указанном каталоге.
//
// Параметры:
//   Каталог - Строка - полный путь каталога;
//   Имя - Строка - имя файла или подкаталога.
//
// Возвращаемое значение:
//   Строка - полный путь файла или каталога.
&НаСервере
Функция ПолучитьПутьФайла(Каталог, Имя)
	Разделитель = "";
	ПоследнийСимвол = Прав(Каталог, 1);
	Если ПоследнийСимвол <> "\" И ПоследнийСимвол <> "/" Тогда
		Разделитель = "\";
	КонецЕсли;
	
	Возврат Каталог + Разделитель + Имя;
КонецФункции

// Заменяет недопустимые в именах файлов символы, чтобы наименование можно было
// использовать как имя файла или каталога.
//
// Параметры:
//   Наименование - Строка - наименование элемента или группы справочника.
//
// Возвращаемое значение:
//   Строка - имя файла или каталога без недопустимых символов.
&НаСервере
Функция БезопасноеИмяФайла(Наименование)
	НедопустимыеСимволы = Новый Массив;
	НедопустимыеСимволы.Добавить("\");
	НедопустимыеСимволы.Добавить("/");
	НедопустимыеСимволы.Добавить(":");
	НедопустимыеСимволы.Добавить("*");
	НедопустимыеСимволы.Добавить("?");
	НедопустимыеСимволы.Добавить("""");
	НедопустимыеСимволы.Добавить("<");
	НедопустимыеСимволы.Добавить(">");
	НедопустимыеСимволы.Добавить("|");
	
	Результат = Наименование;
	Для Каждого Символ Из НедопустимыеСимволы Цикл
		Результат = СтрЗаменить(Результат, Символ, "_");
	КонецЦикла;
	
	Результат = СокрЛП(Результат);
	Если Результат = "" Тогда
		Результат = "Без имени";
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

#КонецОбласти
