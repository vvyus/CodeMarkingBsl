&НаКлиенте
Процедура ЗаписатьФайлВHtml(ВыбранныйФайл)
	
    ТекстHTML=ЗаписатьФайлВHtmlНаСервере();
	
	ТекстДок = Новый ТекстовыйДокумент;
    ТекстДок.УстановитьТекст(ТекстHTML);
    ТекстДок.НачатьЗапись(,ВыбранныйФайл,
                           ПолучитьКодировкуФайла(КодировкаФайла),
                           Символы.ВК + Символы.ПС);
КонецПроцедуры
					   
&НаСервере
Функция ЗаписатьФайлВHtmlНаСервере()                     
	
	ОбработкаОбъект=РеквизитФормыВЗначение("Объект");	
	Токены=ПолучитьСтруктуруДокументаФорматирования();      
	Кодировка=ПолучитьКодировкуФайлаСтрокой(КодировкаФайла);	
	ТекстHTML =ОбработкаОбъект.ПолучитьHtml(Токены,Кодировка);
    Возврат ТекстHTML;
КонецФункции

&НаСервере
Функция ПолучитьСтруктуруДокументаФорматирования()
	Токены=Новый Массив;
	
	КоличествоПараграфов=ЭтотОбъект.ДокументФорматирования.Элементы.Количество()-1;
	
	// обрабатываем параграфы
	Для ц=0 По КоличествоПараграфов Цикл 
		Параграф=ЭтотОбъект.ДокументФорматирования.Элементы[ц];
		//Для Каждого Параграф Из ЭтотОбъект.ДокументФорматирования.Элементы Цикл
		ЭлементыПараграфа=Параграф.Элементы; 
		Если ЭлементыПараграфа<>Неопределено Тогда //и ЭлементыТекста.Количество()=1 
			Для каждого ЭлементПараграфа Из ЭлементыПараграфа Цикл                                            
				Если ТипЗнч(ЭлементПараграфа) = Тип("ТекстФорматированногоДокумента") И ЭлементПараграфа.Текст<>Символы.ПС Тогда
					Текст=ЭлементПараграфа.Текст;
					Цвет=ЭлементПараграфа.ЦветТекста;                      
					ЦветXML = СериализаторXDTO.XMLСтрока(Цвет);
					Токены.Добавить(Новый Структура("Токен,Цвет",Текст,ЦветXML));
				Иначе
					Текст=Символы.ПС;
					Токены.Добавить(Новый Структура("Токен,Цвет",Текст));					
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
//+ВС 26.10.2026 
//новый параграф перевод строки?
		Текст=Символы.ПС;
		Токены.Добавить(Новый Структура("Токен,Цвет",Текст));					
//-ВС 26.10.2026		
		
	КонецЦикла;	
	Возврат Токены;
КонецФункции

&НаСервере
Процедура ЗаписатьДанныеНаСервере()
	//ИмяПроверяемогоРеквизита="ВыбранныйЭлементСправочника";
	//Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект.Параметры, ИмяПроверяемогоРеквизита) Тогда
	Если Не ЭтотОбъект.АвтономныйЗапуск Тогда	
		Токены=ПолучитьСтруктуруДокументаФорматирования();
		ЗаписьJson=Новый ЗаписьJSON; 
		ЗаписьJson.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJson,Токены);
		СтрокаJson=ЗаписьJson.Закрыть();
		
		ОбъектСсылка=Параметры.ВыбранныйЭлементСправочника; 
		Если ОбъектСсылка=Справочники.БР_СписокДокументов.ПустаяСсылка() Тогда
			ОбъектЭлементСправочника=Справочники.БР_СписокДокументов.СоздатьЭлемент();
		Иначе	
			ОбъектЭлементСправочника=ОбъектСсылка.ПолучитьОбъект();
		КонецЕсли;	
		ОбъектЭлементСправочника.ТекстJson=СтрокаJson;     
		ОбработкаОбъект=РеквизитФормыВЗначение("Объект");		
		ТекстHTML =ОбработкаОбъект.ПолучитьHtml(Токены);
		ОбъектЭлементСправочника.ТекстHtml=ТекстHTML; 
		ОбъектЭлементСправочника.Наименование=ЭтотОбъект.Наименование;
		ОбъектЭлементСправочника.Родитель=ЭтотОбъект.Родитель;
//+ВС 26.10.2026 
ОбъектЭлементСправочника.Текст=ЭтотОбъект.ДокументФорматирования.ПолучитьТекст();
//-ВС 26.10.2026		
		ОбъектЭлементСправочника.Записать();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка) 
	
	СтандартнаяОбработка = Ложь;
	Если Не Модифицированность  Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), НСтр("ru = 'Данные были изменены. Сохранить изменения?'"), РежимДиалогаВопрос.ДаНетОтмена);

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Модифицированность = Ложь;
		ЗаписатьДанныеНаСервере();                       
		Оповестить("ОбновитьСписокБиблиотеки", , ЭтотОбъект);
		Закрыть();
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ОчиститьФрагмент(Команда)
	НачалоФрагмента = 0;	
	ОкончаниеФрагмента = 0;
	
	Элементы.ДокументФорматирования.ПолучитьГраницыВыделения(НачалоФрагмента,ОкончаниеФрагмента);
	
	Если РаскраситьВыделенныйКодНаСервере(НачалоФрагмента,ОкончаниеФрагмента,Ложь) Тогда
		//установим курсор в нужной позиции на клиенте			
		Оповестить("УстановитьКурсорВРедакторе", ЭтотОбъект);
	КонецЕсли;	
	
КонецПроцедуры


