#Область ОбработчикиСобытийФормы

// Инициализирует реквизиты формы при ее создании: задает тип и кодировку файла по умолчанию,
// определяет режим запуска и заполняет редактор кодом из параметров формы.
//
// Параметры:
//   Отказ - Булево - признак отказа от создания формы; не изменяется.
//   СтандартнаяОбработка - Булево - признак выполнения стандартной обработки; не изменяется.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	//по дефолту текстовый файл
	ЭтотОбъект.ТипФайла=1;
	//по дефолту анси
	ЭтотОбъект.КодировкаФайла=2;
	ИмяПроверяемогоРеквизита="Ключ";
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект.Параметры, ИмяПроверяемогоРеквизита) Тогда
		ЭтотОбъект.АвтономныйЗапуск=Ложь;
	Иначе
		ЭтотОбъект.АвтономныйЗапуск=Истина;
	КонецЕсли;	
	Если Не ЭтотОбъект.АвтономныйЗапуск Тогда
		Параметры.ВыбранныйЭлементСправочника=Параметры.Ключ.Ссылка;
		Если ЗначениеЗаполнено(Параметры.ТекстJson) Тогда  
			 ЧтениеJson=Новый ЧтениеJSON;
			 ЧтениеJson.УстановитьСтроку(Параметры.ТекстJson);
			 Токены=ПрочитатьJSON(ЧтениеJson,Ложь);
			 ЧтениеJson.Закрыть();
			 ВставитьТекстВДокументФорматированияСРаскраской(Токены);  
		Иначе                           
			Токены=ПолучитьТокены(Параметры.Текст);
			ВставитьТекстВДокументФорматированияБезРаскраски(Токены);  
		КонецЕсли;
		ЭтотОбъект.Наименование=ЭтотОбъект.Параметры.Наименование;
		ЭтотОбъект.Родитель=ЭтотОбъект.Параметры.Родитель;
		ИсходноеКоличествоТокенов=Токены.количество();
	КонецЕсли;	
КонецПроцедуры

// Обрабатывает оповещения формы и устанавливает курсор в редакторе в сохраненную позицию
// при получении оповещения "УстановитьКурсорВРедакторе".
//
// Параметры:
//   ИмяСобытия - Строка - имя полученного оповещения.
//   Параметр - Произвольный - дополнительный параметр оповещения; не используется.
//   Источник - Произвольный - источник оповещения; не используется.
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	//Вставить содержимое обработчика   
	Если ИмяСобытия = "УстановитьКурсорВРедакторе" Тогда
		ПозицияНачала = ДокументФорматирования.ПолучитьЗакладкуПоПозиции(ЭтотОбъект.СохраненнаяПозицияКурсора);
		Элементы.ДокументФорматирования.УстановитьГраницыВыделения(ПозицияНачала,ПозицияНачала);		
		
    КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПодключитьОбработчикОжидания("ПроверитьИзменениеДокументаФорматирования", 1, Ложь);
КонецПроцедуры
#КонецОбласти


#Область ОбработчикиКомандФормы

// Обработчик команды "Раскрасить код": обновляет подсветку синтаксиса всего документа.
//
// Параметры:
//   Команда - КомандаФормы - команда, инициировавшая вызов; не используется.
&НаКлиенте
Процедура РаскраситьКод(Команда)
	ОбновитьРаскраскуКода();	
КонецПроцедуры         

// Обработчик команды "Сохранить код в файл": открывает диалог сохранения файла
// с фильтром, соответствующим выбранному типу файла (текст, JSON, HTML).
//
// Параметры:
//   Команда - КомандаФормы - команда, инициировавшая вызов; не используется.
&НаКлиенте
Процедура СохранитьКодВФайл(Команда)
	Если ЭтотОбъект.ТипФайла=1 Тогда   
		Режим = РежимДиалогаВыбораФайла.Сохранение;
		ДиалогОткрытия = Новый ДиалогВыбораФайла(Режим);
		ДиалогОткрытия.ПолноеИмяФайла = "";
		ДиалогОткрытия.Фильтр = "Text файл  (*.txt)|*.txt";
		ДиалогОткрытия.МножественныйВыбор = Ложь;
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеСохраненияФайлаВText", ЭтотОбъект);
		ДиалогОткрытия.Показать(ОписаниеОповещения);
		
	ИначеЕсли ЭтотОбъект.ТипФайла=2 Тогда	
		
		Режим = РежимДиалогаВыбораФайла.Сохранение;
		ДиалогОткрытия = Новый ДиалогВыбораФайла(Режим);
		ДиалогОткрытия.ПолноеИмяФайла = "";
		ДиалогОткрытия.Фильтр = "Json файл  (*.json)|*.json";
		ДиалогОткрытия.МножественныйВыбор = Ложь;
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеСохраненияФайлаВJson", ЭтотОбъект);
		ДиалогОткрытия.Показать(ОписаниеОповещения);
		
	ИначеЕсли ЭтотОбъект.ТипФайла=3 Тогда   
		Режим = РежимДиалогаВыбораФайла.Сохранение;
		ДиалогОткрытия = Новый ДиалогВыбораФайла(Режим);
		ДиалогОткрытия.ПолноеИмяФайла = "";
		ДиалогОткрытия.Фильтр = "Html файл  (*.html)|*.html";
		ДиалогОткрытия.МножественныйВыбор = Ложь;
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеСохраненияФайлаВHtml", ЭтотОбъект);
		ДиалогОткрытия.Показать(ОписаниеОповещения);
		
	КонецЕсли; 

КонецПроцедуры

// Обработчик команды "Загрузить код из файла": открывает диалог выбора файла
// с фильтром, соответствующим выбранному типу файла (текст, JSON, HTML).
//
// Параметры:
//   Команда - КомандаФормы - команда, инициировавшая вызов; не используется.
&НаКлиенте
Процедура ЗагрузитьКодИзФайла(Команда)
	Если ЭтотОбъект.ТипФайла=1 Тогда
		Режим = РежимДиалогаВыбораФайла.Открытие;
		ДиалогОткрытия = Новый ДиалогВыбораФайла(Режим);
		ДиалогОткрытия.ПолноеИмяФайла = "";
		Фильтр = НСтр("ru = 'Текст'; en = 'Text'")
		+ "(*.txt)|*.txt";
		ДиалогОткрытия.Фильтр = Фильтр;
		ДиалогОткрытия.Заголовок = "Выберите text файл для загрузки";
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗагрузкиФайлаText",ЭтотОбъект);		
		ДиалогОткрытия.Показать(ОписаниеОповещения);
				
	ИначеЕсли ЭтотОбъект.ТипФайла=2 Тогда	
		Режим = РежимДиалогаВыбораФайла.Открытие;
		ДиалогОткрытия = Новый ДиалогВыбораФайла(Режим);  
		ДиалогОткрытия.ПолноеИмяФайла = "";
		Фильтр = "Json файл  (*.json)|*.json";//НСтр("ru = ‘Текст'") + "(*.txt)|*.txt";
		ДиалогОткрытия.Фильтр = Фильтр;
		ДиалогОткрытия.МножественныйВыбор = Ложь;
		ДиалогОткрытия.Заголовок = "Выберете json файл для загрузки";
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗагрузкиФайлаJson",ЭтотОбъект);
		
		ДиалогОткрытия.Показать(ОписаниеОповещения);
		
	ИначеЕсли ЭтотОбъект.ТипФайла=3 Тогда
		Режим = РежимДиалогаВыбораФайла.Открытие;
		ДиалогОткрытия = Новый ДиалогВыбораФайла(Режим);
		ДиалогОткрытия.ПолноеИмяФайла = "";
		Фильтр = НСтр("ru = 'Html'; en = 'Html'")
		+ "(*.html)|*.html";
		ДиалогОткрытия.Фильтр = Фильтр;
		ДиалогОткрытия.Заголовок = "Выберите html файл для загрузки";
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗагрузкиФайлаHtml",ЭтотОбъект);		
		ДиалогОткрытия.Показать(ОписаниеОповещения);
				
		
	КонецЕсли; 
КонецПроцедуры  

// Обработчик команды "Раскрасить выделенный код": раскрашивает синтаксис выделенного фрагмента
// и позиционирует курсор в редакторе.
//
// Параметры:
//   Команда - КомандаФормы - команда, инициировавшая вызов; не используется.
&НаКлиенте
Процедура РаскраситьВыделенныйКод(Команда)
	НачалоФрагмента = 0;	
	ОкончаниеФрагмента = 0;
	
	Элементы.ДокументФорматирования.ПолучитьГраницыВыделения(НачалоФрагмента,ОкончаниеФрагмента);
	
	Если РаскраситьВыделенныйКодНаСервере(НачалоФрагмента,ОкончаниеФрагмента) Тогда
		//установим курсор в нужной позиции на клиенте			
		Оповестить("УстановитьКурсорВРедакторе", ЭтотОбъект);
	КонецЕсли;	
КонецПроцедуры

// Обработчик команды "Вставить код из буфера обмена": вставляет текст из буфера обмена
// в редактор без подсветки синтаксиса. Если доступ к буферу обмена недоступен,
// процедура завершается без изменений.
//
// Параметры:
//   Команда - КомандаФормы - команда, инициировавшая вызов; не используется.
&НаКлиенте
Асинх Процедура ВставитьКодИзБуфераОбмена(Команда) 
	Если Не СредстваБуфераОбмена.ИспользованиеДоступно() Тогда
		Возврат;
	КонецЕсли;	
	Попытка
		ТекстИзБуфера = Ждать СредстваБуфераОбмена.ПолучитьДанныеАсинх(СтандартныйФорматДанныхБуфераОбмена.Текст);
		Если ЗначениеЗаполнено(ТекстИзБуфера) Тогда
			Токены=ПолучитьТокены(ТекстИзБуфера);
			ВставитьТекстВДокументФорматированияБезРаскраски(Токены);			
		КонецЕсли;	
		
	Исключение
		ТекстИзБуфера= ""; // браузер не дал доступ или буфер недоступен
	КонецПопытки;

КонецПроцедуры


&НаКлиенте
Процедура СохранитьИзменения(Команда)
	Модифицированность = Ложь;
	ЗаписатьДанныеНаСервере();                       	
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
&НаКлиенте
Процедура ПроверитьИзменениеДокументаФорматирования()
	КоличествоТокенов = ПолучитьКоличествоТокеновДокументаФорматирования();
//	Шаблон="Исходное : %1 Текущее : %2";
//	Сообщить(СтрШаблон(Шаблон,ИсходноеКоличествоТокенов,КоличествоТокенов));
	Если КоличествоТокенов<>ИсходноеКоличествоТокенов Тогда
		ОтключитьОбработчикОжидания("ПроверитьИзменениеДокументаФорматирования");
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьКоличествоТокеновДокументаФорматирования()
	КоличествоТокенов=0;
	
	КоличествоПараграфов=ЭтотОбъект.ДокументФорматирования.Элементы.Количество()-1;
	
	// обрабатываем параграфы
	Для ц=0 По КоличествоПараграфов Цикл 
		Параграф=ЭтотОбъект.ДокументФорматирования.Элементы[ц];
		//Для Каждого Параграф Из ЭтотОбъект.ДокументФорматирования.Элементы Цикл
		ЭлементыПараграфа=Параграф.Элементы;
		Если ЭлементыПараграфа<>Неопределено Тогда //и ЭлементыТекста.Количество()=1
			КоличествоТокенов=КоличествоТокенов+ЭлементыПараграфа.Количество(); 		 
//			Для каждого ЭлементПараграфа Из ЭлементыПараграфа Цикл                                            
//				Если ТипЗнч(ЭлементПараграфа) = Тип("ТекстФорматированногоДокумента") И ЭлементПараграфа.Текст<>Символы.ПС Тогда
//					КоличествоТокенов=КоличествоТокенов+1;					
//				Иначе
//					КоличествоТокенов=КоличествоТокенов+1;
//					
//				КонецЕсли;
//			КонецЦикла;
		КонецЕсли;
//+ВС 26.10.2026 
//новый параграф перевод строки?
		Если ц<КоличествоПараграфов Тогда
			КоличествоТокенов=КоличествоТокенов+1;
		КонецЕсли;							
//-ВС 26.10.2026		
		
	КонецЦикла;	
	
	Возврат КоличествоТокенов;
КонецФункции


// Обновляет раскраску выделенного кода и позиционирует курсор в редакторе.
// Если раскраска выполнена на сервере, отправляет оповещение "УстановитьКурсорВРедакторе"
// для установки курсора в нужную позицию на клиенте.
&НаКлиенте
Процедура ОбновитьРаскраскуКода()    
	Если РаскраситьВыделенныйКодНаСервере(Неопределено, Неопределено) Тогда
		//установим курсор в нужной позиции на клиенте			
		Оповестить("УстановитьКурсорВРедакторе", ЭтотОбъект);		
	КонецЕсли;
КонецПроцедуры


// Загружает текст из файла в документ форматирования редактора
// с учетом выбранной пользователем кодировки файла.
//
// Использует реквизиты формы ИмяФайла и КодировкаФайла (1 - ANSI, 2 - UTF8,
// иное значение - UTF8 по умолчанию).
&НаСервере
Процедура ЗагрузитьИзФайлаНаСервере()  
	ТекстовыйФайл = Новый ТекстовыйДокумент;             
	Если КодировкаФайла=1 Тогда                          
		Кодировка=КодировкаТекста.ANSI;
	ИначеЕсли КодировкаФайла=2 Тогда   
		Кодировка=КодировкаТекста.UTF8;
	Иначе
		//по умолчанию
		Кодировка=КодировкаТекста.UTF8;
	КонецЕсли;	
    ТекстовыйФайл.Прочитать(ИмяФайла,Кодировка);
	ТекстИзФайла=ТекстовыйФайл.ПолучитьТекст();    
	
    Токены=ПолучитьТокены(ТекстИзФайла);
	ВставитьТекстВДокументФорматированияБезРаскраски(Токены);
КонецПроцедуры

// Заполняет документ форматирования текстом токенов без оформления: очищает документ
// и последовательно добавляет токены, сохраняя переводы строк.
//
// Параметры:
//   Токены - Массив из Структура - токены для вставки; в каждом элементе свойство Токен содержит текст токена.
&НаСервере
Процедура ВставитьТекстВДокументФорматированияБезРаскраски(Токены)  
	//очистим редактор кода
	ДокументФорматирования.Удалить(ДокументФорматирования.ПолучитьЗакладкуНачала());
	Для Каждого Токен Из Токены Цикл                              
		ТекстВставки=Токен.Токен;
		Если ТекстВставки=Символы.ПС Тогда
			ЭлементТекста=ДокументФорматирования.Вставить(ДокументФорматирования.ПолучитьЗакладкуКонца(), ТекстВставки, ТипЭлементаФорматированногоДокумента.ПереводСтроки);	
		Иначе	
			ЭлементТекста=ДокументФорматирования.Вставить(ДокументФорматирования.ПолучитьЗакладкуКонца(), " ", ТипЭлементаФорматированногоДокумента.Текст);	
			ЭлементТекста.Текст=ТекстВставки;
		КонецЕсли;			
	КонецЦикла;
КонецПроцедуры

// Заполняет документ форматирования токенами с сохранением их цвета.
//
// Параметры:
//   Токены - Массив из Структура - токены подсвеченного кода, каждый элемент содержит свойства:
//          * Токен - Строка - текст токена; символ перевода строки вставляется как ПереводСтроки
//          * Цвет - значение типа Цвет в сериализованном виде (XML) - цвет текста токена
//   ПреобразоватьЦвет - Булево - признак преобразования цвета токена при вставке
&НаСервере
Процедура ВставитьТекстВДокументФорматированияСРаскраской(Токены)  
	//очистим редактор кода
	ДокументФорматирования.Удалить(ДокументФорматирования.ПолучитьЗакладкуНачала());
	Для Каждого Токен Из Токены Цикл                              
		ТекстВставки=Токен.Токен;
		Если ТекстВставки=Символы.ПС Тогда
			ЭлементТекста=ДокументФорматирования.Вставить(ДокументФорматирования.ПолучитьЗакладкуКонца(), ТекстВставки, ТипЭлементаФорматированногоДокумента.ПереводСтроки);	
		Иначе	
			ЭлементТекста=ДокументФорматирования.Вставить(ДокументФорматирования.ПолучитьЗакладкуКонца(), " ", ТипЭлементаФорматированногоДокумента.Текст);	
			ЭлементТекста.Текст=ТекстВставки;
			Цвет = СериализаторXDTO.XMLЗначение(Тип("Цвет"), Токен.Цвет);					
			ЭлементТекста.ЦветТекста =Цвет;
				
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры

// Возвращает токены, полученные при разборе переданной строки кода на языке 1С.
//
// Параметры:
//  ВходящаяСтрока - Строка - разбираемый текст кода.
//
// Возвращаемое значение:
//  Массив из Структура - токены с полями:
//   * Токен - Строка - текст токена;
//   * Тип - Число - тип токена: 0 - неизвестный, 1 - идентификатор, 2 - комментарий,
//           3 - разделитель, 4 - ключевой символ или слово, 5 - строка/литерал,
//           6 - директива, 7 - пробелы;
//   * Цвет - Цвет - цвет подсветки токена.
&НаСервере
Функция ПолучитьТокены(ВходящаяСтрока) 	
	ОбработкаОбъект=РеквизитФормыВЗначение("Объект");
	Токены = ОбработкаОбъект.РазобратьСтрокуНаТокены(ВходящаяСтрока);
	Возврат Токены;
КонецФункции	

// Раскрашивает синтаксис выделенного фрагмента форматированного документа,
// разбивая текстовые элементы на токены и присваивая каждому токену цвет.
//
// Параметры:
//   ЗакладкаНачала - ЗакладкаФорматированногоДокумента, Неопределено - начало выделенного фрагмента;
//                   Неопределено - используется закладка начала документа.
//   ЗакладкаКонца - ЗакладкаФорматированногоДокумента, Неопределено - конец выделенного фрагмента;
//                  Неопределено - используется закладка конца документа.
//   УстановитьЦвет - Булево - Истина - присвоить токенам цвета подсветки синтаксиса;
//                    Ложь - сбросить цвет текста на цвет по умолчанию.
//
// Возвращаемое значение:
//   Булево - Истина, если позиция сохраненного курсора была увеличена и требуется установить курсор; иначе - Ложь.
&НаСервере
Функция РаскраситьВыделенныйКодНаСервере(ЗакладкаНачала, ЗакладкаКонца, УстановитьЦвет=Истина)  
	Если ЗакладкаНачала=Неопределено тогда
		ЗакладкаНачала=ДокументФорматирования.ПолучитьЗакладкуНачала();
	КонецЕсли;	
	Если ЗакладкаКонца=Неопределено тогда
		ЗакладкаКонца=ДокументФорматирования.ПолучитьЗакладкуКонца();
	КонецЕсли;	
	
	УстанавливатьКурсор=Ложь;       
	
	ВыделенныеЭлементы = ДокументФорматирования.СформироватьЭлементы(ЗакладкаНачала, ЗакладкаКонца);
	Индекс=ВыделенныеЭлементы.Количество()-1;
	Пока Индекс>=0 Цикл  
		ЭлементПараграфа=ВыделенныеЭлементы[Индекс];
		Если ТипЗнч(ЭлементПараграфа) = Тип("ТекстФорматированногоДокумента") Тогда
			ЭлементТекущийТекст=ЭлементПараграфа.Текст;
			ЗакладкаКонца=Неопределено;
			Токены=ПолучитьТокены(ЭлементТекущийТекст);
			Если Токены.Количество()>0 Тогда //и Токены.Количество()=1
				ЭлементПараграфа.Текст=Токены[0].Токен;
				Если УстановитьЦвет Тогда
					ЭлементПараграфа.ЦветТекста=СериализаторXDTO.XMLЗначение(Тип("Цвет"), Токены[0].Цвет); //ЦветИзHex(Токены[0].Цвет);//Токены[0].Цвет;//ПолучитьЦветТокена(Токены[0]);         
				Иначе                           
					ЭлементПараграфа.ЦветТекста= Новый Цвет();
				КонецЕсли;
				ЗакладкаКонца=ЭлементПараграфа.ЗакладкаКонца;
				//ВставитьТокены=Истина;
				Токены.Удалить(0);
				Для каждого Токен Из Токены Цикл  
					ЭлементТекстаВставки=ДокументФорматирования.Вставить(ЗакладкаКонца, Токен.Токен, ТипЭлементаФорматированногоДокумента.Текст);
					Если ТипЗнч(ЭлементТекстаВставки) = Тип("ТекстФорматированногоДокумента") Тогда
						Если УстановитьЦвет Тогда
							ЭлементТекстаВставки.ЦветТекста =СериализаторXDTO.XMLЗначение(Тип("Цвет"), Токен.Цвет); //ЦветИзHex(Токен.Цвет);                
						Иначе                           
							ЭлементТекстаВставки.ЦветТекста = Новый Цвет();
						КонецЕсли;
						
						ЗакладкаКонца=ЭлементТекстаВставки.ЗакладкаКонца;									
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
			//установить позицию курсора в позицию последнего последнего вставляемого элемента
			Если Индекс=ВыделенныеЭлементы.Количество()-1 Тогда
				Если ЗакладкаКонца<>Неопределено Тогда
					ТекущаяПозицияКурсора=ДокументФорматирования.ПолучитьПозициюПоЗакладке(ЗакладкаКонца); 
					Если ТекущаяПозицияКурсора>ЭтотОбъект.СохраненнаяПозицияКурсора Тогда
						ЭтотОбъект.СохраненнаяПозицияКурсора = ТекущаяПозицияКурсора;
					КонецЕсли;
					УстанавливатьКурсор=Истина;       
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
		Индекс=Индекс-1; 		
	КонецЦикла;	
	Возврат УстанавливатьКурсор;
КонецФункции

// Возвращает кодировку текста по ее числовому коду.
//
// Параметры:
//   КодировкаФайла - Число - код кодировки: 1 - ANSI, 2 - UTF8; для остальных значений - UTF8.
//
// Возвращаемое значение:
//   КодировкаТекста - кодировка текста, соответствующая переданному коду.
&НаСервере
Функция ПолучитьКодировкуФайла(КодировкаФайла)
	Если КодировкаФайла=1 Тогда                          
		Кодировка=КодировкаТекста.ANSI;
	ИначеЕсли КодировкаФайла=2 Тогда   
		Кодировка=КодировкаТекста.UTF8;
	Иначе
		//по умолчанию
		Кодировка=КодировкаТекста.UTF8;
	КонецЕсли;
	Возврат Кодировка;
КонецФункции

// Возвращает наименование кодировки файла по её числовому коду.
//
// Параметры:
//   КодировкаФайла - Число - код кодировки: 1 - windows-1251, 2 - UTF-8.
//                    Для остальных значений возвращается UTF-8.
//
// Возвращаемое значение:
//   Строка - наименование кодировки: "windows-1251" или "UTF-8".
&НаСервере
Функция ПолучитьКодировкуФайлаСтрокой(КодировкаФайла)
	Если КодировкаФайла=1 Тогда                          
		Кодировка="windows-1251";
	ИначеЕсли КодировкаФайла=2 Тогда   
		Кодировка="UTF-8";
	Иначе
		//по умолчанию
		Кодировка="UTF-8";
	КонецЕсли;		
	
	Возврат Кодировка;
КонецФункции

// Возвращает кодировку текста для записи файла по значению реквизита формы КодировкаФайла.
// Предназначена для вызова из клиентского кода.
//
// Возвращаемое значение:
//   КодировкаТекста - кодировка текста для записи файла.
&НаСервере
Функция КодировкаФайлаДляЗаписи()
	Возврат ПолучитьКодировкуФайла(КодировкаФайла);
КонецФункции

// Возвращает наименование кодировки по значению реквизита формы КодировкаФайла.
// Предназначена для вызова из клиентского кода.
//
// Возвращаемое значение:
//   Строка - наименование кодировки: "windows-1251" или "UTF-8".
&НаСервере
Функция КодировкаФайлаСтрокой()
	Возврат ПолучитьКодировкуФайлаСтрокой(КодировкаФайла);
КонецФункции
 
// Загружает на сервере содержимое JSON-файла, выбранного пользователем в диалоге открытия файлов.
//
// Параметры:
//   ВыбранныеФайлы - Массив из Строка - имена выбранных файлов, переданные обработчику оповещения.
//   Параметры - Произвольный - дополнительные параметры обработчика оповещения.
&НаКлиенте
Процедура ПослеЗагрузкиФайлаJson(ВыбранныеФайлы, Параметры) Экспорт

	Если не ЗначениеЗаполнено(ВыбранныеФайлы) Тогда
		Возврат;
	ИначеЕсли ЗначениеЗаполнено(ВыбранныеФайлы) И ВыбранныеФайлы.Количество()=0	Тогда
		Возврат; 
	КонецЕсли;
	
	ВыбранныйФайл=ВыбранныеФайлы[0];	
	ЗагрузитьИзФайлаJsonНаСервере(ВыбранныйФайл);
КонецПроцедуры

// Загружает JSON-файл и вставляет его содержимое в документ форматирования с подсветкой синтаксиса.
//
// Параметры:
//   ВыбранныйФайл - Строка - полный путь к файлу в формате JSON.
&НаСервере
Процедура ЗагрузитьИзФайлаJsonНаСервере(ВыбранныйФайл)

	ЧтениеJson = Новый ЧтениеJSON;
	ЧтениеJson.ОткрытьФайл(ВыбранныйФайл);
	Токены = ПрочитатьJSON(ЧтениеJson);
	ЧтениеJson.Закрыть();
	ВставитьТекстВДокументФорматированияСРаскраской(Токены);

КонецПроцедуры

// Загружает в редактор первый выбранный пользователем файл и инициирует разбор его содержимого на сервере.
//
// Параметры:
//   ВыбранныеФайлы - Массив из Строка - имена файлов, выбранных в диалоге открытия файла
//   Параметры - Структура - параметры, переданные в диалог выбора файла
&НаКлиенте
Процедура ПослеЗагрузкиФайлаText(ВыбранныеФайлы, Параметры) Экспорт

	Если не ЗначениеЗаполнено(ВыбранныеФайлы) Тогда
		Возврат;
	ИначеЕсли ЗначениеЗаполнено(ВыбранныеФайлы) И ВыбранныеФайлы.Количество()=0	Тогда
		Возврат; 
	КонецЕсли;
	
	ВыбранныйФайл=ВыбранныеФайлы[0];	
	ЭтотОбъект.ИмяФайла=ВыбранныйФайл;
	ЗагрузитьИзФайлаНаСервере();
КонецПроцедуры

// Обрабатывает выбор HTML-файла и инициирует чтение его содержимого на сервере.
//
// Параметры:
//   ВыбранныеФайлы - Массив из Строка - пути выбранных файлов; обрабатывается только первый элемент.
//   Параметры - Структура - дополнительные параметры обработчика выбора файла.
&НаКлиенте
Процедура ПослеЗагрузкиФайлаHtml(ВыбранныеФайлы, Параметры) Экспорт

	Если не ЗначениеЗаполнено(ВыбранныеФайлы) Тогда
		Возврат;
	ИначеЕсли ЗначениеЗаполнено(ВыбранныеФайлы) И ВыбранныеФайлы.Количество()=0	Тогда
		Возврат; 
	КонецЕсли;
	
	ВыбранныйФайл=ВыбранныеФайлы[0];	
	ЭтотОбъект.ИмяФайла=ВыбранныйФайл;
	Кодировка=КодировкаФайлаСтрокой();
	ПрочитатьHTMLИзФайлаНаСервере(ВыбранныйФайл,Кодировка);
КонецПроцедуры

// Читает HTML-файл и заполняет документ форматирования текстом элементов span с учётом их цвета.
//
// Параметры:
//   ВыбранныйФайл - Строка - полный путь к HTML-файлу.
//   Кодировка - КодировкаТекста, Строка - кодировка файла. Если не указана, используется ANSI.
&НаСервере
Процедура ПрочитатьHTMLИзФайлаНаСервере(ВыбранныйФайл,Кодировка)
	// Создаём объекты
	Токены=Новый Массив;
	ЧтениеHTML = Новый ЧтениеHTML;
	ПостроительDOM = Новый ПостроительDOM;
	// Указываем путь к файлу и кодировку
	// Второй параметр опционален: если не указать, по умолчанию будет ANSI
	ЧтениеHTML.ОткрытьФайл(ВыбранныйФайл, Кодировка);
	// Загружаем HTML-структуру в объект
	ДокументHTML = ПостроительDOM.Прочитать(ЧтениеHTML);
	СписокЭлементовDom = ДокументHTML.ПолучитьЭлементыПоИмени("span");
	Для Каждого ТекущийЭлементDom Из СписокЭлементовDom Цикл
		// Обработка элемента DOM                     
		Атрибут = ТекущийЭлементDom.Атрибуты.ПолучитьИменованныйЭлемент("style");
		Цвет = Неопределено;
		Если Атрибут <> Неопределено Тогда
			Части = СтрРазделить(Атрибут.Значение, ";");
			Для Каждого Часть Из Части Цикл
				Пара = СтрРазделить(СокрЛп(Часть), ":");
				Если Пара.Количество() = 2 И СокрЛп(Пара[0]) = "color" Тогда
					Цвет = СокрЛп(Пара[1]); // "#963200"
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Текст=ТекущийЭлементDom.ТекстовоеСодержимое;
		Если Цвет=Неопределено Тогда
			Токены.Добавить(Новый Структура("Токен,Цвет",Символы.ПС));					
		Иначе	
			Токены.Добавить(Новый Структура("Токен,Цвет",Текст,Цвет));
		КонецЕсли;
	КонецЦикла;	
	// Обязательно закрываем объект чтения
	ЧтениеHTML.Закрыть();
	ВставитьТекстВДокументФорматированияСРаскраской(Токены);  

КонецПроцедуры

// Обрабатывает завершение диалога сохранения файла и записывает содержимое редактора
// в файл формата JSON.
//
// Параметры:
//   ВыбранныеФайлы - Массив из Строка, Неопределено - пути выбранных файлов; обрабатывается только первый элемент.
//   Параметры - Произвольный - дополнительные параметры обработчика оповещения; не используются.
&НаКлиенте
Процедура ПослеСохраненияФайлаВJson(ВыбранныеФайлы, Параметры) Экспорт
	Если Не ЗначениеЗаполнено(ВыбранныеФайлы) Тогда
		Возврат;
	КонецЕсли;
	ЗаписатьФайлВJson(ВыбранныеФайлы[0]);
КонецПроцедуры

// Записывает содержимое документа форматирования в файл формата JSON.
//
// Параметры:
//   ВыбранныйФайл - Строка - полный путь к файлу.
&НаСервере
Процедура ЗаписатьФайлВJson(ВыбранныйФайл) 
    ЗаписьJson=Новый ЗаписьJSON;
	//ПараметрыЗаписи=Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто);
	ЗаписьJson.ОткрытьФайл(ВыбранныйФайл,"UTF-8");
	Токены=ПолучитьСтруктуруДокументаФорматирования();
	ЗаписатьJSON(ЗаписьJson,Токены);
	ЗаписьJson.Закрыть();
КонецПроцедуры

// Обрабатывает завершение диалога сохранения файла и записывает содержимое редактора
// в текстовый файл.
//
// Параметры:
//   ВыбранныеФайлы - Массив из Строка, Неопределено - пути выбранных файлов; обрабатывается только первый элемент.
//   Параметры - Произвольный - дополнительные параметры обработчика оповещения; не используются.
&НаКлиенте
Процедура ПослеСохраненияФайлаВText(ВыбранныеФайлы, Параметры) Экспорт
	Если Не ЗначениеЗаполнено(ВыбранныеФайлы) Тогда
		Возврат;
	КонецЕсли;
	ЗаписатьФайлВText(ВыбранныеФайлы[0]);
КонецПроцедуры

// Записывает текст документа форматирования в файл с кодировкой,
// выбранной в реквизите формы КодировкаФайла.
//
// Параметры:
//   ВыбранныйФайл - Строка - полный путь к файлу.
&НаКлиенте
Процедура ЗаписатьФайлВText(ВыбранныйФайл) 
	ТекстДок = Новый ТекстовыйДокумент;
	ТекстДок.УстановитьТекст(ДокументФорматирования.ПолучитьТекст());
	ТекстДок.НачатьЗапись(, ВыбранныйФайл,
		КодировкаФайлаДляЗаписи(),
		Символы.ВК + Символы.ПС);
КонецПроцедуры

// Обрабатывает завершение диалога сохранения файла и записывает содержимое редактора
// в файл формата HTML.
//
// Параметры:
//   ВыбранныеФайлы - Массив из Строка, Неопределено - пути выбранных файлов; обрабатывается только первый элемент.
//   Параметры - Произвольный - дополнительные параметры обработчика оповещения; не используются.
&НаКлиенте
Процедура ПослеСохраненияФайлаВHtml(ВыбранныеФайлы, Параметры) Экспорт
	Если Не ЗначениеЗаполнено(ВыбранныеФайлы) Или ВыбранныеФайлы.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	ЗаписатьФайлВHtml(ВыбранныеФайлы[0]);
КонецПроцедуры

// Записывает HTML-представление документа форматирования в файл с кодировкой,
// выбранной в реквизите формы КодировкаФайла.
//
// Параметры:
//   ВыбранныйФайл - Строка - полный путь к файлу.
&НаКлиенте
Процедура ЗаписатьФайлВHtml(ВыбранныйФайл)
	
    ТекстHTML=ЗаписатьФайлВHtmlНаСервере();
	
	ТекстДок = Новый ТекстовыйДокумент;
    ТекстДок.УстановитьТекст(ТекстHTML);
    ТекстДок.НачатьЗапись(,ВыбранныйФайл,
                           КодировкаФайлаДляЗаписи(),
                           Символы.ВК + Символы.ПС);
КонецПроцедуры
					   
// Возвращает HTML-представление содержимого документа форматирования.
//
// Возвращаемое значение:
//   Строка - текст HTML-документа с учетом кодировки, выбранной в реквизите формы КодировкаФайла.
&НаСервере
Функция ЗаписатьФайлВHtmlНаСервере()                     
	
	ОбработкаОбъект=РеквизитФормыВЗначение("Объект");	
	Токены=ПолучитьСтруктуруДокументаФорматирования();      
	Кодировка=ПолучитьКодировкуФайлаСтрокой(КодировкаФайла);	
	ТекстHTML =ОбработкаОбъект.ПолучитьHtml(Токены,Кодировка);
    Возврат ТекстHTML;
КонецФункции

// Возвращает содержимое документа форматирования в виде последовательности токенов.
//
// Возвращаемое значение:
//   Массив из Структура - токены документа:
//     * Токен - Строка - текст токена; для перевода строки содержит Символы.ПС
//     * Цвет - Строка - цвет текста токена, сериализованный в XML
&НаСервере
Функция ПолучитьСтруктуруДокументаФорматирования()
	Токены=Новый Массив;
	
	КоличествоПараграфов=ЭтотОбъект.ДокументФорматирования.Элементы.Количество()-1;
	
	// обрабатываем параграфы
	Для ц=0 По КоличествоПараграфов Цикл 
		Параграф=ЭтотОбъект.ДокументФорматирования.Элементы[ц];
		//Для Каждого Параграф Из ЭтотОбъект.ДокументФорматирования.Элементы Цикл
		ЭлементыПараграфа=Параграф.Элементы; 
		Если ЭлементыПараграфа<>Неопределено Тогда //и ЭлементыТекста.Количество()=1 
			Для каждого ЭлементПараграфа Из ЭлементыПараграфа Цикл                                            
				Если ТипЗнч(ЭлементПараграфа) = Тип("ТекстФорматированногоДокумента") И ЭлементПараграфа.Текст<>Символы.ПС Тогда
					Текст=ЭлементПараграфа.Текст;
					Цвет=ЭлементПараграфа.ЦветТекста;                      
					ЦветXML = СериализаторXDTO.XMLСтрока(Цвет);
					Токены.Добавить(Новый Структура("Токен,Цвет",Текст,ЦветXML));
				Иначе
					Текст=Символы.ПС;
					Токены.Добавить(Новый Структура("Токен,Цвет",Текст));					
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
//+ВС 26.10.2026 
//новый параграф перевод строки?
		Если ц<КоличествоПараграфов Тогда
			Текст=Символы.ПС;
			Токены.Добавить(Новый Структура("Токен,Цвет",Текст));					
		КонецЕсли;
//-ВС 26.10.2026		
		
	КонецЦикла;	
	Возврат Токены;
КонецФункции

// Записывает содержимое редактора в элемент справочника БР_СписокДокументов:
// текст, JSON- и HTML-представления, наименование и родителя.
// В автономном режиме запуска запись не выполняется.
&НаСервере
Процедура ЗаписатьДанныеНаСервере()
	//ИмяПроверяемогоРеквизита="ВыбранныйЭлементСправочника";
	//Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект.Параметры, ИмяПроверяемогоРеквизита) Тогда
	Если Не ЭтотОбъект.АвтономныйЗапуск Тогда	
		Токены=ПолучитьСтруктуруДокументаФорматирования();
		ЗаписьJson=Новый ЗаписьJSON; 
		ЗаписьJson.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJson,Токены);
		СтрокаJson=ЗаписьJson.Закрыть();
		
		ОбъектСсылка=Параметры.ВыбранныйЭлементСправочника; 
		Если ОбъектСсылка=Справочники.БР_СписокДокументов.ПустаяСсылка() Тогда
			ОбъектЭлементСправочника=Справочники.БР_СписокДокументов.СоздатьЭлемент();
		Иначе	
			ОбъектЭлементСправочника=ОбъектСсылка.ПолучитьОбъект();
		КонецЕсли;	
		ОбъектЭлементСправочника.ТекстJson=СтрокаJson;     
		ОбработкаОбъект=РеквизитФормыВЗначение("Объект");		
		ТекстHTML =ОбработкаОбъект.ПолучитьHtml(Токены);
		ОбъектЭлементСправочника.ТекстHtml=ТекстHTML; 
		ОбъектЭлементСправочника.Наименование=ЭтотОбъект.Наименование;
		ОбъектЭлементСправочника.Родитель=ЭтотОбъект.Родитель;
//+ВС 26.10.2026 
ОбъектЭлементСправочника.Текст=ЭтотОбъект.ДокументФорматирования.ПолучитьТекст();
//-ВС 26.10.2026		
		ОбъектЭлементСправочника.Записать();
	КонецЕсли;
КонецПроцедуры

// Запрашивает у пользователя подтверждение сохранения изменений перед закрытием формы.
//
// Параметры:
//   Отказ - Булево - устанавливается в Истина, если требуется отменить закрытие формы.
//   ЗавершениеРаботы - Булево - Истина, если форма закрывается при завершении работы программы.
//   ТекстПредупреждения - Строка - текст предупреждения; не используется.
//   СтандартнаяОбработка - Булево - отключается, так как вопрос задается вручную.
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка) 
	
	СтандартнаяОбработка = Ложь;
	Если Не Модифицированность  Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), НСтр("ru = 'Данные были изменены. Сохранить изменения?'"), РежимДиалогаВопрос.ДаНетОтмена);

КонецПроцедуры

// Обрабатывает ответ пользователя на вопрос о сохранении изменений перед закрытием формы.
//
// Параметры:
//   Ответ - КодВозвратаДиалога - выбранный пользователем вариант ответа.
//   ДополнительныеПараметры - Произвольный - дополнительные параметры обработчика оповещения; не используются.
&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Модифицированность = Ложь;
		ЗаписатьДанныеНаСервере();                       
		Оповестить("ОбновитьСписокБиблиотеки", , ЭтотОбъект);
		Закрыть();
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры


// Обработчик команды "Очистить фрагмент": сбрасывает подсветку синтаксиса выделенного фрагмента.
//
// Параметры:
//   Команда - КомандаФормы - команда, инициировавшая вызов; не используется.
&НаКлиенте
Процедура ОчиститьФрагмент(Команда)
	НачалоФрагмента = 0;	
	ОкончаниеФрагмента = 0;
	
	Элементы.ДокументФорматирования.ПолучитьГраницыВыделения(НачалоФрагмента,ОкончаниеФрагмента);
	
	Если РаскраситьВыделенныйКодНаСервере(НачалоФрагмента,ОкончаниеФрагмента,Ложь) Тогда
		//установим курсор в нужной позиции на клиенте			
		Оповестить("УстановитьКурсорВРедакторе", ЭтотОбъект);
	КонецЕсли;	
	
КонецПроцедуры


// Открывает форму выбора группы справочника БР_СписокДокументов вместо стандартного выбора.
//
// Параметры:
//   Элемент - ПолеФормы - поле, для которого открывается форма выбора.
//   ДанныеВыбора - СписокЗначений из Произвольный, Неопределено - данные выбора; не используются.
//   ВыборДобавлением - Булево - признак выбора с добавлением; не используется.
//   СтандартнаяОбработка - Булево - отключается, так как форма выбора открывается вручную.
&НаКлиенте
Процедура РодительНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	// Отменяем стандартное открытие формы выбора платформой
    СтандартнаяОбработка = Ложь;
    
    // Формируем параметры для открываемой формы
    ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
    
    // Открываем специализированную форму выбора группы справочника
    ОткрытьФорму(
        "Справочник.БР_СписокДокументов.ФормаВыбораГруппы", 
        ПараметрыФормы, 
        Элемент, 
        , 
        , 
        , 
        , 
        РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
    );
КонецПроцедуры
#КонецОбласти
