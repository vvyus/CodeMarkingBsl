// Преобразует числовую составляющую цвета (0..255) в двухсимвольную hex-строку.
//
// Параметры:
//  Значение - Число - составляющая цвета от 0 до 255.
//
// Возвращаемое значение:
//  Строка - два шестнадцатеричных символа.
//
Функция КомпонентЦветаВHex(Значение)
	Шестнадцатеричные = "0123456789ABCDEF";
	Старший = Цел(Значение / 16);
	Младший = Значение % 16;
	Возврат Сред(Шестнадцатеричные, Старший + 1, 1) + Сред(Шестнадцатеричные, Младший + 1, 1);
КонецФункции

// Экранирует спецсимволы HTML, чтобы текст токена не ломал разметку.
//
// Параметры:
//  Текст - Строка - текст токена.
//
// Возвращаемое значение:
//  Строка - безопасный для HTML текст.
//
Функция ЭкранироватьHTML(Текст)
	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Возврат Результат;
КонецФункции

