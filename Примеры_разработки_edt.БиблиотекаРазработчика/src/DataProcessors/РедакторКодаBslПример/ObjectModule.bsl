#КонецОбласти

#Область СлужебныеПроцедурыИФункции  

Функция ПрочитатьПробелы(ВходящаяСтрока,Индекс,ДлинаИсходнойСтроки,Символ)
	ТокенПробела="";
	Пока Индекс <= ДлинаИсходнойСтроки И ЭтоПробел(Символ) Цикл
		ТокенПробела = ТокенПробела + Символ;
		Индекс=Индекс+1;
		Символ = Сред(ВходящаяСтрока, Индекс, 1);
	КонецЦикла;
	//вернем символ на последний символ пробела
	Индекс=Индекс-1;
	Возврат ТокенПробела;
	
КонецФункции

Функция ПрочитатьИдентификатор(ВходящаяСтрока,Индекс,ДлинаИсходнойСтроки,Символ)
	ТокенИдентификатора="";
	Пока Индекс <= ДлинаИсходнойСтроки И (ЭтоБуква(Символ) Или ЭтоЦифра(Символ)) Цикл
		ТокенИдентификатора = ТокенИдентификатора + Символ;
		Индекс=Индекс+1;
		Символ = Сред(ВходящаяСтрока, Индекс, 1);
	КонецЦикла;
	//вернем символ на последний символ идентификатора
	Индекс=Индекс-1;
	Возврат ТокенИдентификатора;
	
КонецФункции

Функция ПрочитатьДирективу(ВходящаяСтрока,Индекс,ДлинаИсходнойСтроки,Символ)
	ТокенДирективы="";
	Пока Индекс <= ДлинаИсходнойСтроки И Символ<>Символы.ПС Цикл
		ТокенДирективы = ТокенДирективы + Символ;
		Индекс=Индекс+1;
		Символ = Сред(ВходящаяСтрока, Индекс, 1);
	КонецЦикла;
	//вернем символ на последний символ директивы
	Индекс=Индекс-1;
	
	Возврат ТокенДирективы;
	
КонецФункции

Функция ПрочитатьКомментарий(ИсходнаяСтрока,Индекс,ДлинаИсходнойСтроки,Символ)
	ТокенКомментария="";
	
	Пока Индекс <= ДлинаИсходнойСтроки И Символ<>Символы.ПС Цикл
		ТокенКомментария = ТокенКомментария + Символ;
		Индекс=Индекс+1;
		Символ = Сред(ИсходнаяСтрока, Индекс, 1);
		Если ТокенКомментария="/" И Символ<>"/" Тогда
			//это не комментарий
			Прервать;
		КонецЕсли;
	КонецЦикла;
	//вернем символ на последний символ комментария
	Индекс=Индекс-1;
	
	Возврат ТокенКомментария;
	
КонецФункции

Функция ПрочитатьЛитерал(ИсходнаяСтрока,Индекс,ДлинаИсходнойСтроки,Символ)
	ТокенЛитерала="";
	Пока Индекс <= ДлинаИсходнойСтроки Цикл
		ТокенЛитерала = ТокенЛитерала + Символ;
		Индекс=Индекс+1;
		Символ = Сред(ИсходнаяСтрока, Индекс, 1);
		Если Символ="'" Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	//закрывающая кавычка входит в литерал, поэтому индекс не сбрасываем
	ТокенЛитерала = ТокенЛитерала + Символ;
	Возврат ТокенЛитерала;
	
КонецФункции

Функция ПрочитатьСтроку(ИсходнаяСтрока,Индекс,ДлинаИсходнойСтроки,Символ,КлючевыеСимволы)
	ТокенСтроки="";
	СимволПред="";
	Пока Индекс <= ДлинаИсходнойСтроки Цикл
		ТокенСтроки = ТокенСтроки + Символ;
		Индекс=Индекс+1;
		СимволПред=Символ;
		Символ = Сред(ИсходнаяСтрока, Индекс, 1);
		
		Если Символ="""" И СимволПред<>"""" И ТокенСтроки<>"""" И Индекс < ДлинаИсходнойСтроки И Сред(ИсходнаяСтрока, Индекс + 1, 1) <> """" Тогда
			ТокенСтроки = ТокенСтроки + Символ; //включаем в токен последнюю кавычку
			Прервать;
		ИначеЕсли ТокенСтроки ="""""" И (СтрНайти(КлючевыеСимволы,Символ)>0 Или ЭтоПробел(Символ)) Тогда
			//для учета 'Символ' в основном цикле
			Индекс=Индекс-1;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	Возврат ТокенСтроки;
КонецФункции

Функция ЭтоПробел(Символ)
	// Определяет, является ли символ пробелом или табуляцией
	Код = КодСимвола(Символ);
	Если Код=9 Тогда
		//табуляция
		Возврат Истина;
	ИначеЕсли Код=32 Тогда
		//пробел
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ЭтоБуква(Символ)
	// Определяет, является ли символ буквой или знаком подчеркивания
	Алфавит = "abcdefghijklmnopqrstuvwxyzабвгдежзийклмнопрстуфхцчшщъыьэюяё_";
	Возврат СтрНайти(Алфавит, НРег(Символ)) > 0;
КонецФункции

Функция ЭтоЦифра(Символ)
	// Определяет, является ли символ цифрой
	Возврат СтрНайти("0123456789", Символ) > 0;
КонецФункции

Функция УточнитьТипТокена(Токен,Тип,КлючевыеСлова,КлючевыеСимволы) 
	ТокенНрег=нрег(Токен);
	Если КлючевыеСлова.Найти(ТокенНрег)<>Неопределено И Тип<>4 Тогда	
		//меняем тип токена
		//4-ключевой токен
		Тип=4; 
	ИначеЕсли СтрНайти(КлючевыеСимволы,ТокенНрег)>0 И Тип<>4 Тогда	
		Тип=4; 
	КонецЕсли;	
	Возврат Тип;
КонецФункции

Процедура ПеренестиТекущийТокенВМассивТокенов(Токены,ТекущийТокен,ТипПред,КлючевыеСлова,КлючевыеСимволы)
	ТипПред=УточнитьТипТокена(ТекущийТокен,ТипПред,КлючевыеСлова,КлючевыеСимволы);
	ЦветТокена=ПолучитьЦветТокена(ТипПред);
	Токены.Добавить( Новый Структура("Токен,Тип,Цвет",ТекущийТокен,ТипПред,ЦветТокена));
КонецПроцедуры

// Возвращает цвет подсветки токена указанного типа.
//
// Параметры:
//  Тип - Число - тип токена (см. РазобратьСтрокуНаТокены).
//
// Возвращаемое значение:
//  Цвет - цвет подсветки токена.
//
Функция ПолучитьЦветТокена(Тип)
	//определяем типы 
	ЦветТокена = ЦветПоУмолчанию();
	Если Тип=1 Тогда
		//1-идентификатор
		ЦветТокена = ЦветИдентификатора();				
	ИначеЕсли Тип=2 Тогда
		//2-комментарий
		ЦветТокена = ЦветКомментария();
	ИначеЕсли Тип=3 Тогда		
		//3-разделитель
	ИначеЕсли Тип=4 Тогда
		//4-ключевой символ
		ЦветТокена = ЦветКлючевогоСлова();				
	ИначеЕсли Тип=5 Тогда
		//5-строка
		ЦветТокена = ЦветСтроки();

	ИначеЕсли Тип=6 Тогда
		//6-служебный
		ЦветТокена = ЦветСлужебный(); 
	КонецЕсли;	
	Возврат ЦветТокена;
КонецФункции	

Функция ОформитьТокен(Токен,ШаблонПс,Шаблон)
	Если Токен.Токен=Символы.ПС Тогда
		СтрокаШаблон=СтрШаблон(ШаблонПс,Токен.Токен);
	Иначе
		ЦветCSS=ЦветВCSS(Токен.Цвет);
		ТекстHTML=ЭкранироватьHTML(Токен.Токен);
		СтрокаШаблон=СтрШаблон(Шаблон,ЦветCSS,ТекстHTML);
	КонецЕсли;
	Возврат СтрокаШаблон;
КонецФункции

