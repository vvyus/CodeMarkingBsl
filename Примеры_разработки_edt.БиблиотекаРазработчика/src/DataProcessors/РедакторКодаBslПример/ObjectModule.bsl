#Область ПрограммныйИнтерфейс   
// Формирует HTML-представление кода 1С с подсветкой синтаксиса.
//
// Параметры:
//  Токены - Массив из Структура - токены для вывода (см. РазобратьСтрокуНаТокены), элемент структуры:
//   * Токен - Строка - текст токена;
//   * Тип - Число - тип токена;
//   * Цвет - Цвет - цвет подсветки токена.
//  Кодировка - Строка - кодировка для <meta charset>. По умолчанию "windows-1251".
//
// Возвращаемое значение:
//  Строка - HTML-документ.
//
Функция ПолучитьHTML(Токены,Кодировка="windows-1251") Экспорт
	СтрокаШаблона="
	|<html>	
	|<head>
	|<meta charset=""%1""> 
	|<style> 
	|.tabbed {
	|    white-space: pre;
	|  }	
	|html {
	|	background-color: #e9e9e9;
	|	font-family: 'Consolas', monospace;
	|}  
	|</style>	
	|</head>
	|<body>	
	|<pre><code>%2</code></pre>	
	|</body>
	|</html>
	|";
	
	Тело = "";
	ШаблонПс = "<span style='line-height: 0;'>%1</span>";
	Шаблон = "<span style='color: %1; line-height: 1.2;'>%2</span>";

	Для Каждого Токен Из Токены Цикл
		ТекущийТокен = ОформитьТокен(Токен, ШаблонПс, Шаблон);
		Тело = Тело + ТекущийТокен;
	КонецЦикла;
	HTMLДокумент = СтрШаблон(СтрокаШаблона, Кодировка, Тело);

	Возврат HTMLДокумент;
КонецФункции

// Разбирает текст кода 1С на токены с указанием их типа и цвета подсветки.
//
// Параметры:
//  ВходящаяСтрока - Строка - исходный текст кода.
//
// Возвращаемое значение:
//  Массив из Структура - токены с полями:
//   * Токен - Строка - текст токена;
//   * Тип - Число - тип токена: 0 - неизвестный, 1 - идентификатор, 2 - комментарий,
//           3 - разделитель, 4 - ключевой символ или слово, 5 - строка/литерал,
//           6 - директива, 7 - пробелы;
//   * Цвет - Цвет - цвет подсветки токена.
//
Функция РазобратьСтрокуНаТокены(ВходящаяСтрока) Экспорт
	КлючевыеСимволы=ПолучитьКлючевыеСимволы();
	КлючевыеСлова=ПолучитьКлючевыеСлова();
	ПоУмолчаниюСимволы=ПолучитьСимволыПоУмолчанию();
	Токены = Новый Массив;
	ТекущийТокен = "";
	
	Индекс = 1;
	Тип = 0;
	ВходящаяСтрока = СтрЗаменить(ВходящаяСтрока, Символы.ВК, "");
	ДлинаИсходнойСтроки = СтрДлина(ВходящаяСтрока);
	Пока Индекс <= ДлинаИсходнойСтроки Цикл
		Символ = Сред(ВходящаяСтрока, Индекс, 1);
		ТекущийТокен = "";
		//определяем типы 
		//1-идентификатор,
		//2-комментарий,
		//3-разделитель
		//4-ключевой символ
		//5-строка
		//6-служебный     
		//7-пробелы
		Если Символ="/" Тогда 
			ТекущийТокен=ПрочитатьКомментарий(ВходящаяСтрока,Индекс,ДлинаИсходнойСтроки,Символ);
			Если ТекущийТокен="/" Тогда
				// одиночный "/" - это оператор деления, а не начало комментария
				Тип=4;
			Иначе
				Тип=2;
			КонецЕсли;			
		ИначеЕсли Символ="""" Тогда 			
			//начало строки
			ТекущийТокен=ПрочитатьСтроку(ВходящаяСтрока,Индекс,ДлинаИсходнойСтроки,Символ,КлючевыеСимволы);
			Тип=5;	
		ИначеЕсли Символ="'" Тогда 			
			//начало литерала                                                        			
			ТекущийТокен=ПрочитатьЛитерал(ВходящаяСтрока,Индекс,ДлинаИсходнойСтроки,Символ);
			Тип=5;	
		ИначеЕсли Символ=Символы.ПС Тогда 	
			ТекущийТокен=Символ;
			Тип=3; //разделитель
		ИначеЕсли Символ="#" ИЛИ Символ="&" Тогда 			
			//начало директивы
			ТекущийТокен=ПрочитатьДирективу(ВходящаяСтрока,Индекс,ДлинаИсходнойСтроки,Символ);
			Тип=6; 
			
		ИначеЕсли ЭтоБуква(Символ) Тогда 	
			ТекущийТокен=ПрочитатьИдентификатор(ВходящаяСтрока,Индекс,ДлинаИсходнойСтроки,Символ);
			Тип=1; 
			
		ИначеЕсли ЭтоПробел(Символ) Тогда 	
			ТекущийТокен=ПрочитатьПробелы(ВходящаяСтрока,Индекс,ДлинаИсходнойСтроки,Символ);
			Тип=7; 
			
		ИначеЕсли СтрНайти(КлючевыеСимволы,Символ)>0 Тогда 			
			ТекущийТокен=Символ;
			Тип=4;                                  
		ИначеЕсли СтрНайти(ПоУмолчаниюСимволы,Символ)>0 Тогда
			ТекущийТокен=Символ;
			Тип=5;			           
		Иначе    
			ТекущийТокен = Символ;
			Тип = 0;
		КонецЕсли;	
		
		Если ТекущийТокен<>"" Тогда
			// сброс токена в массив токенов
			ПеренестиТекущийТокенВМассивТокенов(Токены,ТекущийТокен,Тип,КлючевыеСлова,КлючевыеСимволы);
		КонецЕсли;	      
		
		Индекс=Индекс+1;
	КонецЦикла;              
	Возврат Токены;
КонецФункции

